{
  "name": "cursor-token-monitor",
  "displayName": "Cursor Token Monitor",
  "description": "Cursor AI usage in the status bar — daily/session stats, model analytics, spend alerts, rotating status bar, CSV/JSON/Markdown export.",
  "publisher": "ahmed404abd",
  "version": "1.3.0",
  "license": "MIT",
  "homepage": "https://github.com/ahmed404abd/cursor-token-monitor",
  "bugs": {
    "url": "https://github.com/ahmed404abd/cursor-token-monitor/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ahmed404abd/cursor-token-monitor.git"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": ["Visualization", "Other"],
  "keywords": [
    "cursor",
    "usage",
    "tokens",
    "billing",
    "status bar",
    "ai",
    "spend",
    "pro",
    "export"
  ],
  "galleryBanner": {
    "color": "#1a1a1a",
    "theme": "dark"
  },
  "activationEvents": ["onStartupFinished"],
  "main": "./out/extension.js",
  "icon": "media/icon.png",
  "contributes": {
    "commands": [
      {
        "command": "cursorTokenMonitor.refresh",
        "title": "Cursor Token Monitor: Refresh Usage"
      },
      {
        "command": "cursorTokenMonitor.showDetails",
        "title": "Cursor Token Monitor: Show Details"
      },
      {
        "command": "cursorTokenMonitor.openDashboard",
        "title": "Cursor Token Monitor: Open Usage Dashboard"
      },
      {
        "command": "cursorTokenMonitor.copyUsageReport",
        "title": "Cursor Token Monitor: Copy Usage Report"
      },
      {
        "command": "cursorTokenMonitor.exportCsv",
        "title": "Cursor Token Monitor: Export CSV"
      },
      {
        "command": "cursorTokenMonitor.exportJson",
        "title": "Cursor Token Monitor: Export JSON"
      },
      {
        "command": "cursorTokenMonitor.exportMarkdown",
        "title": "Cursor Token Monitor: Export Markdown"
      },
      {
        "command": "cursorTokenMonitor.exportData",
        "title": "Cursor Token Monitor: Export Usage Data…"
      },
      {
        "command": "cursorTokenMonitor.resetCache",
        "title": "Cursor Token Monitor: Reset Cache"
      },
      {
        "command": "cursorTokenMonitor.checkConnection",
        "title": "Cursor Token Monitor: Check Connection"
      },
      {
        "command": "cursorTokenMonitor.privacyAudit",
        "title": "Cursor Token Monitor: Run Privacy Audit"
      }
    ],
    "configuration": {
      "title": "Cursor Token Monitor",
      "properties": {
        "cursorTokenMonitor.refreshIntervalSeconds": {
          "type": "number",
          "default": 60,
          "minimum": 15,
          "maximum": 3600,
          "description": "How often to refresh usage data, in seconds."
        },
        "cursorTokenMonitor.customDatabasePath": {
          "type": "string",
          "default": "",
          "description": "Override path to Cursor's state.vscdb file. Leave empty to auto-detect."
        },
        "cursorTokenMonitor.pythonPath": {
          "type": "string",
          "default": "",
          "description": "Path to a Python 3 executable. Leave empty to auto-detect (py / python / python3)."
        },
        "cursorTokenMonitor.statusBarMode": {
          "type": "string",
          "enum": ["spend", "rotate"],
          "default": "spend",
          "enumDescriptions": [
            "Always show spend vs allowance (e.g. $4.12/$20).",
            "Rotate every few seconds between spend, top model, and total tokens."
          ],
          "description": "What the status bar item shows."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "package": "vsce package --no-dependencies",
    "publish:marketplace": "vsce publish --no-dependencies"
  },
  "devDependencies": {
    "@types/vscode": "^1.85.0",
    "@types/node": "^20.0.0",
    "typescript": "^5.4.0",
    "@vscode/vsce": "^2.32.0"
  }
}
