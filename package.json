{
  "name": "cursor-token-monitor",
  "displayName": "Cursor Token Monitor",
  "description": "Private Cursor AI usage cockpit — dual Pro quotas, burn-rate forecasts, heatmap, alerts. No Python required.",
  "publisher": "ahmed404abd",
  "version": "1.5.0",
  "license": "MIT",
  "homepage": "https://github.com/ahmed404abd/cursor-token-monitor",
  "bugs": {
    "url": "https://github.com/ahmed404abd/cursor-token-monitor/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ahmed404abd/cursor-token-monitor.git"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Visualization",
    "Other"
  ],
  "keywords": [
    "cursor",
    "usage",
    "tokens",
    "billing",
    "status bar",
    "ai",
    "spend",
    "pro",
    "export",
    "dashboard",
    "cockpit",
    "forecast",
    "heatmap"
  ],
  "galleryBanner": {
    "color": "#0d1117",
    "theme": "dark"
  },
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "icon": "media/icon.png",
  "contributes": {
    "commands": [
      {
        "command": "cursorTokenMonitor.refresh",
        "title": "Cursor Token Monitor: Refresh Usage"
      },
      {
        "command": "cursorTokenMonitor.showDetails",
        "title": "Cursor Token Monitor: Show Details"
      },
      {
        "command": "cursorTokenMonitor.openDashboard",
        "title": "Cursor Token Monitor: Open Usage Dashboard"
      },
      {
        "command": "cursorTokenMonitor.openQuickPick",
        "title": "Cursor Token Monitor: Open QuickPick"
      },
      {
        "command": "cursorTokenMonitor.copyUsageReport",
        "title": "Cursor Token Monitor: Copy Usage Report"
      },
      {
        "command": "cursorTokenMonitor.exportCsv",
        "title": "Cursor Token Monitor: Export CSV"
      },
      {
        "command": "cursorTokenMonitor.exportJson",
        "title": "Cursor Token Monitor: Export JSON"
      },
      {
        "command": "cursorTokenMonitor.exportMarkdown",
        "title": "Cursor Token Monitor: Export Markdown"
      },
      {
        "command": "cursorTokenMonitor.exportData",
        "title": "Cursor Token Monitor: Export Usage Data…"
      },
      {
        "command": "cursorTokenMonitor.resetCache",
        "title": "Cursor Token Monitor: Reset Cache"
      },
      {
        "command": "cursorTokenMonitor.checkConnection",
        "title": "Cursor Token Monitor: Check Connection"
      },
      {
        "command": "cursorTokenMonitor.privacyAudit",
        "title": "Cursor Token Monitor: Run Privacy Audit"
      }
    ],
    "configuration": {
      "title": "Cursor Token Monitor",
      "properties": {
        "cursorTokenMonitor.refreshIntervalSeconds": {
          "type": "number",
          "default": 60,
          "minimum": 15,
          "maximum": 3600,
          "description": "How often to refresh usage data, in seconds."
        },
        "cursorTokenMonitor.customDatabasePath": {
          "type": "string",
          "default": "",
          "description": "Override path to Cursor's state.vscdb file. Leave empty to auto-detect."
        },
        "cursorTokenMonitor.statusBarMode": {
          "type": "string",
          "enum": [
            "spend",
            "rotate"
          ],
          "default": "spend",
          "enumDescriptions": [
            "Keep a single status-bar format.",
            "Rotate every few seconds between formatted spend, top/pinned model, and total tokens."
          ],
          "description": "Whether the status bar stays fixed or rotates metrics."
        },
        "cursorTokenMonitor.statusBarFormat": {
          "type": "string",
          "enum": [
            "icon",
            "dot",
            "percent",
            "dotPercent",
            "namePercent",
            "full"
          ],
          "default": "full",
          "enumDescriptions": [
            "Icon only",
            "Health dot + icon",
            "Icon + percent",
            "Dot + percent",
            "Pinned/top model name + percent",
            "Full spend vs allowance with health label"
          ],
          "description": "Status bar text format."
        },
        "cursorTokenMonitor.notificationsEnabled": {
          "type": "boolean",
          "default": true,
          "description": "Show allowance and unusual-spend notifications."
        },
        "cursorTokenMonitor.warningThreshold": {
          "type": "number",
          "default": 75,
          "minimum": 1,
          "maximum": 99,
          "description": "Percent of included allowance that triggers warning styling/alerts. Must be lower than criticalThreshold."
        },
        "cursorTokenMonitor.criticalThreshold": {
          "type": "number",
          "default": 90,
          "minimum": 2,
          "maximum": 100,
          "description": "Percent of included allowance that triggers critical styling/alerts."
        },
        "cursorTokenMonitor.viewMode": {
          "type": "string",
          "enum": [
            "card",
            "list"
          ],
          "default": "card",
          "description": "Cockpit card layout: grid of cards or denser list rows."
        },
        "cursorTokenMonitor.displayMode": {
          "type": "string",
          "enum": [
            "dashboard",
            "quickpick"
          ],
          "default": "dashboard",
          "description": "Open the webview cockpit or a keyboard-friendly QuickPick list."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "test": "tsc -p ./ && node --test out/__tests__/*.js",
    "package": "vsce package --no-dependencies",
    "publish:marketplace": "vsce publish --no-dependencies"
  },
  "dependencies": {
    "sortablejs": "^1.15.6"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/sortablejs": "^1.15.8",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^2.32.0",
    "typescript": "^5.4.0"
  }
}
